{
  "name": "margin-markdown",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, local-first Markdown reader and editor for the desktop.",
  "desktopName": "margin",
  "author": {
    "name": "imfeelingtheagi",
    "email": "imfeelingtheagi@users.noreply.github.com"
  },
  "homepage": "https://github.com/imfeelingtheagi/margin",
  "repository": {
    "type": "git",
    "url": "https://github.com/imfeelingtheagi/margin.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:reader": "vitest run --exclude **/agent*.test.ts",
    "test:reader:desktop": "npm run build && node scripts/reader-qa.cjs",
    "test:desktop": "npm run build && node scripts/desktop-smoke.cjs",
    "test:agent": "npm run build && node scripts/agent-smoke.cjs",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "latest",
    "@codemirror/lang-markdown": "latest",
    "@codemirror/language-data": "latest",
    "@codemirror/search": "latest",
    "@codemirror/state": "latest",
    "@codemirror/view": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/katex": "latest",
    "@types/markdown-it": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@uiw/react-codemirror": "latest",
    "@vitejs/plugin-react": "latest",
    "@vscode/markdown-it-katex": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "dompurify": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "highlight.js": "latest",
    "jsdom": "latest",
    "katex": "0.19.1",
    "lucide-react": "latest",
    "markdown-it": "latest",
    "markdown-it-anchor": "latest",
    "markdown-it-deflist": "latest",
    "markdown-it-footnote": "latest",
    "markdown-it-mark": "latest",
    "markdown-it-sub": "latest",
    "markdown-it-sup": "latest",
    "markdown-it-task-lists": "latest",
    "mermaid": "latest",
    "playwright": "1.62.1",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "overrides": {
    "katex": "$katex"
  },
  "build": {
    "appId": "app.margin.markdown",
    "productName": "Margin",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": "txt",
        "name": "Plain Text Document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "perMachine": true
    },
    "linux": {
      "category": "Office",
      "executableArgs": [
        "%F"
      ],
      "icon": "build/icon.png",
      "maintainer": "imfeelingtheagi <imfeelingtheagi@users.noreply.github.com>",
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown",
        "text/plain"
      ],
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
